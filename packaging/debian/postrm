#!/bin/sh
# После удаления systemd забывает службы; при purge уходит и /var/lib/eliterec (скачанные пакеты,
# отметки). Записи и настройки менеджеров — в их профилях, пакет их не трогает.
set -e

case "$1" in
    remove|purge)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
esac

if [ "$1" = purge ]; then
    rm -rf /var/lib/eliterec
fi

exit 0
