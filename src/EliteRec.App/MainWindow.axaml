<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EliteRec.App"
        xmlns:res="using:EliteRec.App.Resources"
        x:Class="EliteRec.App.MainWindow" x:DataType="app:MainPanelModel"
        Title="EliteRec" Width="380" Height="520" MinWidth="320" MinHeight="420"
        Background="Transparent" TransparencyLevelHint="Transparent" WindowDecorations="None" Foreground="#ECE8DF"
        WindowStartupLocation="CenterScreen" Icon="avares://EliteRec.App/Assets/eliterec.png">
  <!-- Макет 6 «Стеклянная волна» (docs/PLAN.md, «Интерфейс»): слева Вы (L, золотой), справа Система (R, голубой).
       Текста минимум: таймер и плашка, только когда есть что сказать. -->
  <Window.Styles>
    <Style Selector="Border.grip"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ComboBox.chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Устройство — просто текст со значком и шевроном (можно сменить); стрелка шаблона ComboBox не нужна -->
    <Style Selector="ComboBox.chip /template/ ToggleButton#toggle"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="ComboBox.chip:pointerover /template/ Border#border"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ComboBox.chip:pointerover"><Setter Property="Foreground" Value="#FFFFFF" /></Style>
    <Style Selector="Border.bar">
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.glow">
      <Setter Property="Width" Value="360" />
      <Setter Property="Height" Value="360" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Grid.wave">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.3" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Grid.wave.paused"><Setter Property="Opacity" Value="0.35" /></Style>
    <Style Selector="Button.glass">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="CornerRadius" Value="23" />
      <Setter Property="Background" Value="#0AFFFFFF" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.glass:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.red">
      <Setter Property="Width" Value="68" />
      <Setter Property="Height" Value="68" />
      <Setter Property="CornerRadius" Value="34" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Кнопка записи: до записи бледная и без свечения, в записи — яркая красная со свечением:
         пишем или нет — видно издалека -->
    <Style Selector="Border.face">
      <Setter Property="BoxShadow" Value="0 6 16 0 #66000000" />
      <Setter Property="Background">
        <RadialGradientBrush GradientOrigin="35%,30%" Center="35%,30%" RadiusX="80%" RadiusY="80%">
          <GradientStop Offset="0" Color="#8C5B54" />
          <GradientStop Offset="1" Color="#5A3631" />
        </RadialGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Border.face.recording">
      <Setter Property="BoxShadow" Value="0 0 24 0 #8CE05A47, 0 8 20 0 #80000000" />
      <Setter Property="Background">
        <RadialGradientBrush GradientOrigin="35%,30%" Center="35%,30%" RadiusX="80%" RadiusY="80%">
          <GradientStop Offset="0" Color="#FF8A74" />
          <GradientStop Offset="1" Color="#C8402F" />
        </RadialGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Button.red:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1FFFFFFF" />
    </Style>
    <!-- Точка у таймера: серая до записи, красная мигает в записи (по таймеру окна, не анимацией), жёлтая на паузе -->
    <Style Selector="Ellipse.dot"><Setter Property="Fill" Value="#6D685E" /></Style>
    <Style Selector="Ellipse.dot.paused"><Setter Property="Fill" Value="#F0D48A" /></Style>
    <Style Selector="Ellipse.dot.live"><Setter Property="Fill" Value="#E05A47" /></Style>
    <!-- Кольцо вокруг «Стоп», пока идёт запись. Без анимации: непрерывная перерисовка с частотой экрана
         заметно грузит слабый ПК (A6), а яркая кнопка и мигающая точка и так говорят «пишем». -->
    <Style Selector="Ellipse.ring"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="Ellipse.ring.live">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="RenderTransform" Value="scale(1.2)" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#0DFFFFFF" />
      <Setter Property="BorderBrush" Value="#17FFFFFF" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.notice TextBlock"><Setter Property="Foreground" Value="#A9A397" /></Style>
    <Style Selector="Border.notice.warning">
      <Setter Property="Background" Value="#CC2E2717" />
      <Setter Property="BorderBrush" Value="#6B5626" />
    </Style>
    <Style Selector="Border.notice.warning TextBlock"><Setter Property="Foreground" Value="#F0D48A" /></Style>
  </Window.Styles>
  <Window.DataTemplates>
    <DataTemplate DataType="app:DeviceOption" x:DataType="app:DeviceOption">
      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
    </DataTemplate>
  </Window.DataTemplates>

  <!-- Окно без системных рамок: свой заголовок (app:TitleBar) повторяет системный, фон — цвет окна, как в EliteSIP.
       Скругление верхних углов — как у темы xfwm. -->
  <Panel>
  <Border Classes="frame">
    <Border Classes="frame-inner">
      <DockPanel>
        <app:TitleBar DockPanel.Dock="Top" />
        <Panel>
          <!-- Подсветка фона за говорящей стороной -->
          <Ellipse Classes="glow" HorizontalAlignment="Left" Margin="-120,120,0,0" Opacity="{Binding Wave.LeftGlow.Opacity}">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Offset="0" Color="#73D6B35C" />
                <GradientStop Offset="0.7" Color="#00D6B35C" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse Classes="glow" HorizontalAlignment="Right" Margin="0,120,-120,0" Opacity="{Binding Wave.RightGlow.Opacity}">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Offset="0" Color="#737FB0E8" />
                <GradientStop Offset="0.7" Color="#007FB0E8" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>

          <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
            <!-- Верх: устройство «Вы» | таймер | устройство «Система» — устройства просто текстом.
                 Выбор синхронизирует code-behind: новый ItemsSource сбрасывает SelectedItem, и привязка к нему после этого молчит. -->
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" ClipToBounds="True" ToolTip.Tip="{Binding MicrophoneLabel}">
                <app:Icon Kind="mic.fill" Foreground="#D6B35C" Width="18" Height="18" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Name="MicrophoneBox" Classes="chip" HorizontalAlignment="Left" ItemsSource="{Binding Microphones}" SelectionChanged="OnDeviceChosen" IsEnabled="{Binding CanChooseDevices}"
                          Foreground="#E6D3A3" AutomationProperties.Name="{x:Static res:Text.You}">
                  <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate x:DataType="app:DeviceOption">
                      <DockPanel>
                        <app:Icon DockPanel.Dock="Right" Kind="chevron.down" Foreground="#8C877C" Width="13" Height="13" Margin="2,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Chip}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ComboBox.SelectionBoxItemTemplate>
                </ComboBox>
              </Grid>
              <Border Grid.Column="1" Height="32" CornerRadius="16" Padding="8,0" Background="#0FFFFFFF" BorderBrush="#17FFFFFF" BorderThickness="1"
                      BoxShadow="0 6 20 0 #73000000" VerticalAlignment="Center" ToolTip.Tip="{Binding Status}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Name="TimerDot" Classes="dot" Classes.live="{Binding IsLive}" Classes.paused="{Binding IsPaused}" Width="8" Height="8" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding TimerLabel}" FontFamily="monospace" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="5" ClipToBounds="True" ToolTip.Tip="{Binding OutputLabel}">
                <ComboBox Name="OutputBox" Classes="chip" HorizontalAlignment="Right" ItemsSource="{Binding Outputs}" SelectionChanged="OnDeviceChosen" IsEnabled="{Binding CanChooseDevices}"
                          Foreground="#C4DAF4" AutomationProperties.Name="{x:Static res:Text.SystemAudio}">
                  <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate x:DataType="app:DeviceOption">
                      <DockPanel>
                        <app:Icon DockPanel.Dock="Right" Kind="chevron.down" Foreground="#8C877C" Width="13" Height="13" Margin="2,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Chip}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ComboBox.SelectionBoxItemTemplate>
                </ComboBox>
                <app:Icon Grid.Column="1" Kind="speaker.wave.2" Foreground="#7FB0E8" Width="18" Height="18" VerticalAlignment="Center" />
              </Grid>
            </Grid>

            <!-- Незавершённая запись после сбоя -->
            <Border Grid.Row="1" IsVisible="{Binding HasRecovery}" Background="#CC2E2717" BorderBrush="#6B5626" BorderThickness="1" CornerRadius="14" Padding="12"
                    BoxShadow="0 10 28 0 #8C000000">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding RecoveryText}" Foreground="#F0D48A" TextWrapping="Wrap" FontSize="12" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <Button Content="{x:Static res:Text.Recover}" Click="OnRecoverRecording" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" CornerRadius="18" />
                  <Button Grid.Column="1" Content="{x:Static res:Text.Discard}" Click="OnDiscardRecording" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" CornerRadius="18" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Волна: от оси влево — Вы, вправо — Система; на паузе гаснет -->
            <Grid Grid.Row="2" Classes="wave" Classes.paused="{Binding IsPaused}" ColumnDefinitions="*,2,*" ColumnSpacing="3">
              <ItemsControl ItemsSource="{Binding Wave.LeftBars}" FlowDirection="RightToLeft">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="16" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="app:LevelBar" x:DataType="app:LevelBar">
                    <Border Classes="bar" Height="{Binding Height}" Opacity="{Binding Opacity}">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                          <GradientStop Offset="0" Color="#00D6B35C" />
                          <GradientStop Offset="0.3" Color="#D6B35C" />
                          <GradientStop Offset="0.5" Color="#F0D48A" />
                          <GradientStop Offset="0.7" Color="#D6B35C" />
                          <GradientStop Offset="1" Color="#00D6B35C" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Grid.Column="1" Height="200" CornerRadius="1" VerticalAlignment="Center">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#00FFFFFF" />
                    <GradientStop Offset="0.5" Color="#59FFFFFF" />
                    <GradientStop Offset="1" Color="#00FFFFFF" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <ItemsControl Grid.Column="2" ItemsSource="{Binding Wave.RightBars}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="16" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="app:LevelBar" x:DataType="app:LevelBar">
                    <Border Classes="bar" Height="{Binding Height}" Opacity="{Binding Opacity}">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                          <GradientStop Offset="0" Color="#007FB0E8" />
                          <GradientStop Offset="0.3" Color="#7FB0E8" />
                          <GradientStop Offset="0.5" Color="#B7D4F5" />
                          <GradientStop Offset="0.7" Color="#7FB0E8" />
                          <GradientStop Offset="1" Color="#007FB0E8" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>

            <!-- Плашка — только когда есть что сказать: пауза, предупреждение, «Сохранено», нет звука -->
            <Border Grid.Row="3" Classes="notice" Classes.warning="{Binding IsWarning}" IsVisible="{Binding HasNotice}">
              <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" TextAlignment="Center" />
            </Border>

            <!-- Стеклянная капсула: до записи — настройки | запись | папка; в записи — пауза | стоп | папка -->
            <Border Grid.Row="4" HorizontalAlignment="Center" CornerRadius="44" Padding="18,10" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                    BoxShadow="0 14 36 0 #99000000">
              <StackPanel Orientation="Horizontal" Spacing="22">
                <Button Name="SettingsButton" Classes="glass" IsVisible="{Binding ShowStart}" IsEnabled="{Binding CanChooseDevices}" Click="OnOpenSettings"
                        ToolTip.Tip="{x:Static res:Text.Settings}" AutomationProperties.Name="{x:Static res:Text.Settings}">
                  <app:Icon Kind="gearshape" Foreground="#ECE8DF" Width="20" Height="20" />
                </Button>
                <Button Classes="glass" IsVisible="{Binding IsRecording}" IsEnabled="{Binding CanPauseRecording}" Click="OnPauseRecording"
                        ToolTip.Tip="{Binding PauseLabel}" AutomationProperties.Name="{Binding PauseLabel}">
                  <Panel>
                    <app:Icon Kind="pause.fill" Foreground="#ECE8DF" Width="20" Height="20" IsVisible="{Binding !IsPaused}" />
                    <app:Icon Kind="play.fill" Foreground="#F0D48A" Width="20" Height="20" IsVisible="{Binding IsPaused}" />
                  </Panel>
                </Button>

                <Panel Width="68" Height="68">
                  <Ellipse Classes="ring" Classes.live="{Binding IsLive}" Stroke="#E05A47" StrokeThickness="2" IsHitTestVisible="False" />
                  <Border Classes="face" Classes.recording="{Binding IsRecording}" CornerRadius="34">
                    <Panel>
                      <Button Name="StartRecordingButton" Classes="red" IsVisible="{Binding ShowStart}" IsEnabled="{Binding CanStartRecording}" Click="OnStartRecording"
                              ToolTip.Tip="{x:Static res:Text.StartRecording}" AutomationProperties.Name="{x:Static res:Text.StartRecording}">
                        <Ellipse Width="20" Height="20" Fill="#E6C9C3" />
                      </Button>
                      <Button Classes="red" IsVisible="{Binding IsRecording}" IsEnabled="{Binding CanStopRecording}" Click="OnStopRecording"
                              ToolTip.Tip="{x:Static res:Text.Stop}" AutomationProperties.Name="{x:Static res:Text.Stop}">
                        <Border Width="20" Height="20" CornerRadius="5" Background="#FFF3EE" />
                      </Button>
                    </Panel>
                  </Border>
                </Panel>

                <Button Classes="glass" Click="OnOpenFolder" ToolTip.Tip="{x:Static res:Text.OpenFolder}" AutomationProperties.Name="{x:Static res:Text.OpenFolder}">
                  <app:Icon Kind="folder" Foreground="#ECE8DF" Width="20" Height="20" />
                </Button>
              </StackPanel>
            </Border>
          </Grid>
        </Panel>
      </DockPanel>
    </Border>
  </Border>
  <!-- Края и углы для изменения размера: системной рамки нет, тянем сами (BeginResizeDrag) -->
  <Panel Name="ResizeGrips" IsVisible="{Binding $parent[Window].CanResize}">
    <Border Classes="grip" Tag="West" Width="6" HorizontalAlignment="Left" Cursor="LeftSide" />
    <Border Classes="grip" Tag="East" Width="6" HorizontalAlignment="Right" Cursor="RightSide" />
    <Border Classes="grip" Tag="South" Height="6" VerticalAlignment="Bottom" Cursor="BottomSide" />
    <Border Classes="grip" Tag="North" Height="4" VerticalAlignment="Top" Cursor="TopSide" />
    <Border Classes="grip" Tag="SouthWest" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="BottomLeftCorner" />
    <Border Classes="grip" Tag="SouthEast" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="BottomRightCorner" />
    <Border Classes="grip" Tag="NorthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="TopLeftCorner" />
    <Border Classes="grip" Tag="NorthEast" Width="10" Height="4" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="TopRightCorner" />
  </Panel>
  </Panel>
</Window>
